#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=linux
# VERSION=${VERSION:-6.10-rc2}
VERSION=${VERSION:-6.6.62}
BUILD=${BUILD:-1}
TAG=${TAG:-_perrin4869}
PKGTYPE=${PKGTYPE:-tgz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

# If your oldconfig was builded by u and your old kernel`s name is taged by you asume: "6.0.13-tag"
# then add your TAG in VERSION_TAGGED. Example VERSION_TAGGED=6.0.14-TAG else script will fail using oldconfig.
VERSION_TAGGED=${VERSION_TAGGED:-${VERSION/-rc/.0-rc}}
if [[ $VERSION_TAGGED =~ ^[0-9]+\.[0-9]+$ ]]; then
  VERSION_TAGGED=$VERSION_TAGGED.0
fi
NJOBS=${NJOBS:-$(nproc)}

CC=${CC:-gcc}

# Newer GCC (16+) defaults to a C standard (C23) where bool/true/false are
# reserved keywords, colliding with kernel code (pre-C23 vintage) that still
# hand-defines them itself (typedef _Bool bool; enum { false, true }; see
# include/linux/stddef.h/types.h). The main kernel build pins -std=gnu11
# explicitly (KBUILD_CFLAGS) and is unaffected, but several long-standing
# "freestanding" sub-builds define their own from-scratch CFLAGS that don't
# inherit that pin at all -- the 16-bit realmode trampoline
# (arch/x86/realmode/) and the EFI boot stub (drivers/firmware/efi/libstub/)
# are two found so far, and there could be others not yet discovered.
# Fixing it via $CC itself instead of patching each such Makefile covers all
# of them in one place, since none of these sub-Makefiles override CC
# itself, only the flags passed alongside it.
#
# Fixed upstream in Linux 7.1 (commit ec4c28276c14, "kbuild: Consolidate C
# dialect options" by Nathan Chancellor), which introduced CC_FLAGS_DIALECT
# and threaded it into REALMODE_CFLAGS and other arch Makefiles. Not
# backported to any earlier stable branch. Slackware's own kernel-source
# package for the still-pre-7.1 6.18.x series instead patches -std=gnu11
# directly into REALMODE_CFLAGS and the efi-stub's cflags-$(CONFIG_X86) --
# i.e. the same whack-a-mole, one-Makefile-at-a-time approach this comment
# is deliberately avoiding.
#
# Detect whether this is actually necessary, rather than assuming a GCC
# version cutoff, by checking what standard this compiler defaults to.
GCC_DEFAULT_STDC=$(echo | $CC -dM -E - 2>/dev/null | sed -n 's/^#define __STDC_VERSION__ \([0-9]*\).*/\1/p')
if [ -n "$GCC_DEFAULT_STDC" ] && [ "$GCC_DEFAULT_STDC" -ge 202311 ]; then
  CC="$CC -std=gnu11"
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
if [[ "$VERSION" =~ -rc[0-9]+$ ]]; then
  tar xvzf $CWD/$PRGNAM-$VERSION.tar.gz
else
  tar xvJf $CWD/$PRGNAM-$VERSION.tar.xz
fi
cd $PRGNAM-$VERSION
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

VERSION_SERIES=$(echo "$VERSION" | cut -d. -f1,2)
CONFIG_FILE=config-$VERSION_SERIES
if [[ -e "$CWD/$CONFIG_FILE" ]]; then
  cp $CWD/$CONFIG_FILE .config
else
  zcat /proc/config.gz > .config
fi

make CC="$CC" oldconfig
make CC="$CC" -j$NJOBS
make CC="$CC" modules_install INSTALL_MOD_PATH=$PKG

# Deliberately not running "make headers_install" into $PKG/usr: that writes
# sanitized UAPI headers to /usr/include/{asm,linux,...}, the same paths
# Slackware's own kernel-headers-<ver> package owns. Two packages claiming
# the same files means removepkg on either one deletes files the other still
# expects, and since kernel-headers is meant to track your *primary* kernel
# (whatever userspace/glibc was built against), a side/test kernel package
# has no business overwriting or removing it. Confirmed by inspecting
# Slackware-current's own kernel-source package: it owns files only under
# /usr/src, zero files under /usr/include -- that split is intentional.
# Out-of-tree/DKMS module builds don't need this either; they build against
# /usr/src/linux-$VERSION via the /lib/modules/.../build symlink below, not
# against /usr/include.
# make CC="$CC" headers_install INSTALL_HDR_PATH=$PKG/usr

# Grab these before "make clean" below removes them.
mkdir $PKG/boot
cp arch/x86_64/boot/bzImage $PKG/boot/vmlinuz-"$VERSION_TAGGED"
cp System.map $PKG/boot/System.map-"$VERSION_TAGGED"

# Trim the built tree down before packaging it as /usr/src: "make clean" is
# documented to "remove most generated files but keep the config and enough
# build support to build external modules" (make help), i.e. it drops the
# .o/.ko/vmlinux build products but keeps .config, Module.symvers,
# include/generated/*, etc. Without this, the packaged /usr/src tree used
# to be a snapshot of the *pre-build* source (copied before "make oldconfig"
# ran), missing everything needed to build an out-of-tree/DKMS module
# against it later -- Slackware's own kernel-source packages ship these
# files pre-baked for the same reason.
make CC="$CC" clean

mkdir -p $PKG/usr/src
cp -r ../$PRGNAM-$VERSION $PKG/usr/src

# override the build and source symlinks to match the source in the package
rm $PKG/lib/modules/$VERSION_TAGGED/build
  ln -sf /usr/src/linux-$VERSION $PKG/lib/modules/$VERSION_TAGGED/build

# 6.6-rc1 doesn't seem to install a sources symlink, so use -f to ignore errors
if [[ -h "$PKG/lib/modules/$VERSION_TAGGED/source" ]]; then
  rm $PKG/lib/modules/$VERSION_TAGGED/source
ln -sf /usr/src/linux-$VERSION $PKG/lib/modules/$VERSION_TAGGED/source
fi

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat <<EOF > $PKG/install/doinst.sh
VERSION=$VERSION_TAGGED
\$(/usr/share/mkinitrd/mkinitrd_command_generator.sh -k \$VERSION -r | sed "s/initrd.gz/initrd-\$VERSION.gz/g")
EOF
cat <<EOF > $PKG/install/douninst.sh
rm -f /boot/initrd-$VERSION_TAGGED.gz
EOF

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM${VERSION_SERIES}-${VERSION_TAGGED/-/_}-$ARCH-$BUILD$TAG.$PKGTYPE
